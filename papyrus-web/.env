WEBAPP_VERSION=2024.10.0

#PapyrusWeb database
POSTGRES_DB=papyrus-web-database
POSTGRES_USER=dbuser
POSTGRES_PASSWORD=dbpwd

#PapyrusWeb backend variables
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres/papyrus-web-database
SPRING_DATASOURCE_USERNAME=dbuser
SPRING_DATASOURCE_PASSWORD=dbpwd
SIRIUS_COMPONENTS_CORS_ALLOWEDORIGINPATTERNS="*"
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=50MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=50MB
SERVER_TOMCAT_RESPONSE_WRITE_BUFFER_SIZE=32KB
SERVER_PORT=8080
IOMT_GENERATOR_URL=htto://localhost:9000

#PapyrusWeb react variables
MODEL_SERVICE_URL=http://localhost:8083

#Used only for docker build   
GIT_USERNAME=${GIT_USERNAME}
GIT_PASSWORD=${GIT_PASSWORD}