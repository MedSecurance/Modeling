          <language>OCL</language>
          <body>ownedOperation->exists(op | op.name = 'rateLimit' and op.ownedParameter->size() = 1)  </body>
        </specification>
      </ownedRule>
      <ownedOperation xmi:id="9867a61f-b9e6-4599-9d91-5862978b0aae" name="rateLimit">
        <ownedParameter xmi:id="e3234906-5e32-4c68-a94c-dc386524fc61" name="limit">
          <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
        </ownedParameter>
      </ownedOperation>
    </packagedElement>
    <packagedElement xmi:type="uml:Class" xmi:id="a33cf7fc-9caf-42d1-b585-204e62051c9d" name="AdminApplication">
