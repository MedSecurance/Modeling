    <packagedElement xmi:type="uml:Class" xmi:id="21a85b39-175d-4c81-a1a8-5266a9e129fb" name="Proxy">
      <ownedRule xmi:id="372bdb8a-5c62-48e8-8e24-320044a5cd45" name="CWE284_287RBACAccess" constrainedElement="21a85b39-175d-4c81-a1a8-5266a9e129fb">
        <specification xmi:type="uml:OpaqueExpression" xmi:id="91ba64f9-06fe-4799-8986-051a9224323f" name="cwe284_287">
          <language>OCL</language>
          <body>context self cwe798: 
let supFeatures : Sequence(OclAny) = getStereotypeApplications()->select(e | e.eClass().name = 'IoMTcomponent')->collect( component | 
component.eGet(component.eClass().getEStructuralFeature('supportedFeatures')))->asSequence() in 

supFeatures->includesAll(Sequence{'roleBasedAuthentication'})

and getStereotypeApplications()->select(e | e.eClass().name = 'Proxy')->size() = 1</body>
        </specification>
      </ownedRule>
    </packagedElement>
    <packagedElement xmi:type="uml:Class" xmi:id="5cfc80a8-7cf5-49c1-ad8f-9b6db06afb0e" name="FHIRDatabase">
      <ownedRule xmi:id="19696033-ee58-4987-866d-cc0c8996fc5b" name="CWE89_200encryptHealthRecord" constrainedElement="5cfc80a8-7cf5-49c1-ad8f-9b6db06afb0e">
        <specification xmi:type="uml:OpaqueExpression" xmi:id="0a3aba94-984c-40ac-b299-7075d9308e8c" name="cweEncryptedData">
          <language>OCL</language>
          <body>context self: 

let supFeatures : Sequence(OclAny) = getStereotypeApplications()->select(e | e.eClass().name = 'IoMTcomponent')->collect( component | 
component.eGet(component.eClass().getEStructuralFeature('supportedFeatures')))->asSequence() in 

supFeatures->includesAll(Sequence{'encryptedDataStorage'}) 

and getStereotypeApplications()->select(e | e.eClass().name = 'DataStore')->size() = 1

and
getStereotypeApplications()->select(e | e.eClass().name = 'Information')->collect( component | 
component.eGet(component.eClass().getEStructuralFeature('kind')))->asSequence()->first() = IoMTAssets::InformationKind::PatientHealthRecords</body>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="52e8854b-2a9b-4968-8e61-72cac74e1173" name="CWE89_200_SQLInjection" constrainedElement="5cfc80a8-7cf5-49c1-ad8f-9b6db06afb0e">
        <specification xmi:type="uml:OpaqueExpression" xmi:id="0bdf7a21-521c-407c-86f9-02e34693acc2" name="cwe89200SQLInjection">
          <language>OCL</language>
          <body>context self: 
ownedOperation->forAll(op |  
      op.ownedParameter->exists(p | p.name = 'ParameterizedQuery')  
   )  


</body>
        </specification>
      </ownedRule>
      <ownedOperation xmi:id="f540c094-7a8c-4c96-9535-40d817595915" name="returnFields"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Class" xmi:id="fc922a2b-d9d8-4fe9-95f5-e091dc577f52" name="MQTTGateway">
      <ownedRule xmi:id="cd0d4862-7984-4296-b074-fe19c775ad03" name="CWE319_327TLSCommunication">
        <specification xmi:type="uml:OpaqueExpression" xmi:id="761d9744-c85a-43e4-bb2a-bae8ee9c7353" name="cwe319_327">
          <language>OCL</language>
          <body>context self cwe798: 
let supFeatures : Sequence(OclAny) = getStereotypeApplications()->select(e | e.eClass().name = 'IoMTcomponent')->collect( component | 
component.eGet(component.eClass().getEStructuralFeature('supportedFeatures')))->asSequence() in 

supFeatures->includesAll(Sequence{'mostSecureCommunicationProtocol'}) 

and getStereotypeApplications()->select(e | e.eClass().name = 'Gateway')->size() = 1</body>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="bcd04284-58a3-4a22-a113-38bab608adaf" name="CWE770-rateLimiting" constrainedElement="fc922a2b-d9d8-4fe9-95f5-e091dc577f52">
