  <uml:Model xmi:id="7e1b9658-2ae9-4354-b59c-83cafed873f0" name="IoMTCWEModel">
    <ownedComment xmi:id="a373d126-3d1e-4abf-a489-c13084cb2129">
      <body>This model has a set of OCL Constraints defined based on the Common Weakness Enumeration list: https://cwe.mitre.org/data/index.html

We defined three subsets of constraints:
1 - that checks applied ComponentCategories properties;
2 - that checks applied Assets and its properties;
3 - structural constraints in the model.
The list of constraints may be obtained by selecting the root model element and running the command below in the &quot;Query View&quot;:

aql:self.eAllContents()->select(e | e.eClass().name = 'Constraint')

</body>
    </ownedComment>
    <packageImport xmi:id="7edc3485-2ec9-40bd-9696-d32f334263e5">
      <importedPackage xmi:type="uml:Model" href="pathmap://UML_METAMODELS/UML.metamodel.uml#_0"/>
    </packageImport>
    <packagedElement xmi:type="uml:Class" xmi:id="5bee6ff4-b83d-496c-9db6-68305324c30a" name="HeartMonitoring">
      <ownedRule xmi:id="f48b6b23-d7d2-4a17-9706-9427f6ea0788" name="CWE798_noHardCodedCredentials" constrainedElement="5bee6ff4-b83d-496c-9db6-68305324c30a">
        <specification xmi:type="uml:OpaqueExpression" xmi:id="21159039-c4b7-4ebb-a7cd-4689119ef0c0" name="cwe798">
          <language>OCL</language>
          <body>context self cwe798: 
let supFeatures : Sequence(OclAny) = getStereotypeApplications()->select(e | e.eClass().name = 'IoMTcomponent')->collect( component | 
component.eGet(component.eClass().getEStructuralFeature('supportedFeatures')))->asSequence() in 

supFeatures->includesAll(Sequence{'factoryPasswordGenerator'})</body>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="7b0f25e2-47d1-460a-95b4-3eab60e373e3" name="CWE506_secureBoot" constrainedElement="5bee6ff4-b83d-496c-9db6-68305324c30a">
        <specification xmi:type="uml:OpaqueExpression" xmi:id="4a62a940-8b2e-4573-b41e-e6855f4d445c" name="cwe506">
          <language>OCL</language>
          <body>context self cwe506: 
let supFeatures : Sequence(OclAny) = getStereotypeApplications()->select(e | e.eClass().name = 'IoMTcomponent')->collect( component | 
component.eGet(component.eClass().getEStructuralFeature('supportedFeatures')))->asSequence() in 

supFeatures->includes('bootSoftware')
</body>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="b97f58d1-5bd6-4a23-ad35-ebcc8f06ecb6" name="CWE921_tamperDetection" constrainedElement="5bee6ff4-b83d-496c-9db6-68305324c30a">
        <specification xmi:type="uml:OpaqueExpression" xmi:id="bbdb7408-f8ed-49db-8d9f-3e7b141daf7e" name="cwe921">
          <language>OCL</language>
          <body>context self cwe798: 
let supFeatures : Sequence(OclAny) = getStereotypeApplications()->select(e | e.eClass().name = 'IoMTcomponent')->collect( component | 
component.eGet(component.eClass().getEStructuralFeature('supportedFeatures')))->asSequence() in 

supFeatures->includesAll(Sequence{'temperProofIndetityStorage'})</body>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="14f75059-5b68-44da-b728-86b8082c7038" name="CWE1279_GeoLocation" constrainedElement="5bee6ff4-b83d-496c-9db6-68305324c30a">
        <specification xmi:type="uml:OpaqueExpression" xmi:id="7ce758db-569d-4110-9f0d-b1cac298d9f7" name="cwe1279">
          <language>OCL</language>
          <body>context self: 

let supFeatures : Sequence(OclAny) = getStereotypeApplications()->select(e | e.eClass().name = 'IoMTcomponent')->collect( component | 
component.eGet(component.eClass().getEStructuralFeature('supportedFeatures')))->asSequence() in 

supFeatures->includesAll(Sequence{'geoLocatedReporter'}) 

and

getStereotypeApplications()->select(e | e.eClass().name = 'Information')->collect( component | 
component.eGet(component.eClass().getEStructuralFeature('kind')))->asSequence()->first() = IoMTAssets::InformationKind::RealTimePatientData</body>
        </specification>
      </ownedRule>
      <nestedClassifier xmi:type="uml:Class" xmi:id="6b3eaecb-4b16-46d4-a7fb-abc5a1ed71c8" name="Thermometer">
        <ownedRule xmi:id="1b7c01ec-1a79-43b1-aaf7-ccdfbb28ca82" name="hasSensorAndService" constrainedElement="6b3eaecb-4b16-46d4-a7fb-abc5a1ed71c8">
          <specification xmi:type="uml:OpaqueExpression" xmi:id="e0451c77-76dc-4fca-b153-ba27264a5eec" name="hasSensorAndDevice">
            <language>OCL</language>
            <body>getAppliedStereotypes()->select(as | as.name ='Sensor' or as.name = 'Service')->asSequence()->size() = 2</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:id="c66573dc-b31b-42c3-817d-843172bb5267" name="CWE494_347_firmwareUpdates" constrainedElement="6b3eaecb-4b16-46d4-a7fb-abc5a1ed71c8">
          <specification xmi:type="uml:OpaqueExpression" xmi:id="e2c5ec99-a445-47e8-b109-4d817103016e" name="cwe494_347">
            <language>OCL</language>
            <body>context self: 
let supFeatures : Sequence(OclAny) = getStereotypeApplications()->select(e | e.eClass().name = 'IoMTcomponent')->collect( component | 
component.eGet(component.eClass().getEStructuralFeature('supportedFeatures')))->asSequence() in 

supFeatures->includesAll(Sequence{'updateStatusMonitor','asymetricCryptography'})</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:id="84d0eb0c-45fd-43d5-a3ad-e3bb0e4ca045" name="CWE1316_failSafeMode" constrainedElement="6b3eaecb-4b16-46d4-a7fb-abc5a1ed71c8">
          <specification xmi:type="uml:OpaqueExpression" xmi:id="74d6c6d0-788a-41c9-a066-3dad74c3f9e5" name="cwe1316">
            <language>OCL</language>
            <body>context self: 

let supFeatures : Sequence(OclAny) = getStereotypeApplications()->select(e | e.eClass().name = 'IoMTcomponent')->collect( component | 
component.eGet(component.eClass().getEStructuralFeature('supportedFeatures')))->asSequence() in 

supFeatures->includesAll(Sequence{'failSafeMode'}) 

and

getStereotypeApplications()->select(e | e.eClass().name = 'Service')->collect( component | 
component.eGet(component.eClass().getEStructuralFeature('kind')))->asSequence()->first() = IoMTAssets::ServiceKind::ThermometerMonitoring
</body>
          </specification>
        </ownedRule>
      </nestedClassifier>
      <nestedClassifier xmi:type="uml:Class" xmi:id="a360fb51-e1f7-409e-bb54-f904526b5002" name="SwitchLED"/>
      <nestedClassifier xmi:type="uml:Class" xmi:id="75f69f91-56d7-4442-80a9-1308c49f59c1" name="Hygrometer"/>
