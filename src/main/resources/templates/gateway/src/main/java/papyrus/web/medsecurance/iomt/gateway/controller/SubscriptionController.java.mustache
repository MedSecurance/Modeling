package papyrus.web.medsecurance.iomt.gateway.controller;

import org.hl7.fhir.r4.model.Bundle;
import org.hl7.fhir.r4.model.Device;
import org.hl7.fhir.r4.model.Subscription;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestHeader;
import org.springframework.web.bind.annotation.RestController;

import ca.uhn.fhir.context.FhirContext;

@RestController
public class SubscriptionController {
	private Logger logger = LoggerFactory.getLogger(SubscriptionController.class);
	
	@Autowired
	protected FhirContext fhirContext;

	@PostMapping("/webhook")
    public void handleSubscription(@RequestBody String payload, 
                                   @RequestHeader("Content-Type") String contentType) {
		
        if (contentType.equals("application/fhir+json")) {
            Bundle bundle = (Bundle) fhirContext.newJsonParser().parseResource(Bundle.class, payload);
            
            logger.info("Received FHIR Subscription Notification: " + bundle.getId());

            bundle.getEntry().forEach(entry -> {
            	if (entry.getResource() instanceof Device) {
                    Device device = (Device) entry.getResource();
                    logger.debug("Resource Type: " + entry.getResource().getResourceType());
                    logger.debug("Resource ID: " + device.getIdElement().getIdPart());
            	}
            });
        }
	}
	
	@GetMapping(value = "/fhir/Device/{id}", produces = "application/json")
	public ResponseEntity<Device> getDevice(@PathVariable String id) {
		logger.debug(id);
		return new ResponseEntity<>(null, HttpStatus.OK);
	}
	
	@GetMapping(value = "/fhir/Subscription/{id}", produces = "application/json")
	public ResponseEntity<Subscription> getSubscription(@PathVariable String id) {
		logger.debug(id);
		return new ResponseEntity<>(null, HttpStatus.OK);
	}
}
