package papyrus.web.medsecurance.iomt.device.action;

import org.eclipse.paho.client.mqttv3.IMqttClient;
import org.eclipse.paho.client.mqttv3.MqttException;
import org.eclipse.paho.client.mqttv3.MqttMessage;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

import papyrus.web.medsecurance.iomt.device.dto.{{baseClassName}};

public class SendMessage{{baseClassName}}Action implements IAction {
	private Logger logger = LoggerFactory.getLogger(SendMessage{{baseClassName}}Action.class);
	private final {{baseClassName}} sensor;
	private final IMqttClient mqttClient;

	public SendMessage{{baseClassName}}Action({{baseClassName}} sensor, IMqttClient mqttClient) {
		this.sensor = sensor;
		this.mqttClient = mqttClient;
	}

	@Override
	public boolean executeAction(String cmd, byte[] payload) {
		MqttMessage mqttMessage = new MqttMessage();
		mqttMessage.setPayload((sensor.getValue() + "%").getBytes());
		mqttMessage.setQos(0);
		mqttMessage.setRetained(false);

		try {
			String topic = cmd + "/" + {{baseClassName}}.getCommand();
			mqttClient.publish(topic, mqttMessage);
		} catch (MqttException mqtte) {
			logger.error(mqtte.getMessage());
		}
		return true;
	}

}
