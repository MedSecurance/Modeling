package papyrus.web.medsecurance.iomt.gateway.service;

import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import java.util.Optional;

import org.hl7.fhir.instance.model.api.IIdType;
import org.hl7.fhir.r4.model.Bundle;
import org.hl7.fhir.r4.model.Device;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import ca.uhn.fhir.context.FhirContext;
import ca.uhn.fhir.rest.client.api.IGenericClient;
import papyrus.web.medsecurance.iomt.gateway.dto.DeviceDTO;

@Service
public class DeviceService {
	private Logger logger = LoggerFactory.getLogger(DeviceService.class);
	
	@Autowired
	protected FhirContext fhirContext;

	@Autowired
	protected IGenericClient fhirClient;

	public List<DeviceDTO> findAll() {
		Bundle results = fhirClient.search().forResource(Device.class).returnBundle(Bundle.class).execute();

		if (results.hasEntry()) {
			List<DeviceDTO> devices = new ArrayList<DeviceDTO>();
			for (Bundle.BundleEntryComponent entry : results.getEntry()) {
				IIdType id = entry.getResource().getIdElement();
				logger.info(id.getIdPart());
				
				Device device = (Device) entry.getResource();
				logger.info(device.getIdElement().asStringValue());
				
				DeviceDTO deviceDTO = new DeviceDTO(device.getIdElement().getIdPart(), device.getDeviceName().getLast().getName(),
						device.getManufacturer(), device.getStatus(), Optional.empty(), Optional.empty());
				devices.add(deviceDTO);
			}
			return devices; 
		}

		return Collections.emptyList();
	}

}
