package papyrus.web.medsecurance.iomt.gateway.controller;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import papyrus.web.medsecurance.iomt.gateway.dto.GatewayDTO;
import papyrus.web.medsecurance.iomt.gateway.service.GatewayService;

@RestController
@RequestMapping("/gateway")
public class GatewayController {
	@Autowired
    private GatewayService gatewayService;
	
	@GetMapping(produces = "application/json;charset=utf-8")
    public ResponseEntity<GatewayDTO> getGatewayInformation() {
		try {
			return new ResponseEntity<>(gatewayService.getGatewayInformation(), HttpStatus.OK);
		} catch (Exception e) {
			return new ResponseEntity<>(HttpStatus.NO_CONTENT);
		}
    }

	// Initialize Gateway and Start Device (publish) from Patient id
	@PutMapping(consumes = {"application/json"}, produces = "application/fhir+json;charset=utf-8")
    public ResponseEntity<GatewayDTO> initDevice(@RequestBody GatewayDTO gatewayDTO) {
    	try {
		return new ResponseEntity<>(gatewayService.setGatewayInformation(gatewayDTO), HttpStatus.OK);
	} catch (Exception e) {
		return new ResponseEntity<>(HttpStatus.NO_CONTENT);
    }}
    
}
